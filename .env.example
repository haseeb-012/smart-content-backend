# Copy to .env and fill in. Never commit .env. Never put these in the frontend.
ENV=local

# Supabase Postgres (Project Settings → Database → Connection string, "URI").
# Use the asyncpg driver. Session pooler (port 5432) recommended; for the transaction pooler (6543) set DB_USE_POOLER=true.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_USE_POOLER=false

# Supabase Auth — the backend verifies user access tokens against this project's JWKS.
SUPABASE_URL=https://<project-ref>.supabase.co

CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Billing — TEST MODE ONLY. The app refuses to start with live keys.
# Set BILLING_PROVIDER=stripe_test once the keys + prices below are filled in.
# Prefer a restricted key (rk_test_…) with: Customers write, Checkout Sessions write,
# Customer portal write, Subscriptions read.
BILLING_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:8000/api/v1/billing/webhook` (local) or the Dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# Test-mode Price IDs (Products → Pro/Visionary/Titan, monthly + yearly recurring prices)
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_VISIONARY_MONTHLY=
STRIPE_PRICE_VISIONARY_YEARLY=
STRIPE_PRICE_TITAN_MONTHLY=
STRIPE_PRICE_TITAN_YEARLY=
DASHBOARD_URL=http://localhost:3001

# AI — Gemini (decision D11). Used from step 5.
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Later steps
# APIFY_TOKEN=
# GROQ_API_KEY=
# REDIS_URL=
# SENTRY_DSN=
